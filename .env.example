# =============================================================================
# payment-service configuration (copy to `.env`:  cp .env.example .env)
#
# The values below are PLACEHOLDERS for local development and CI only.
# Real secrets must NEVER be committed: `.env` is git-ignored, only this example file is tracked.
# Generate your own secrets, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Format notes (the file is read by Docker Compose AND by pydantic-settings):
#   - one KEY=value per line, no quotes, no spaces around "=", comments on their own lines;
#   - POSTGRES_PASSWORD and RABBITMQ_DEFAULT_PASS are embedded into connection URLs by
#     docker-compose.yml - use URL-safe characters only (letters, digits, "-", "_", ".", "~");
#   - do not use "$" in values (Compose treats it as variable interpolation).
# =============================================================================

# -----------------------------------------------------------------------------
# Infrastructure containers (used by docker-compose.yml)
# -----------------------------------------------------------------------------

# PostgreSQL superuser created on first start of the `postgres` container.
POSTGRES_USER=payments
# PostgreSQL password (also used to build DB_URL inside compose). Change it.
POSTGRES_PASSWORD=change-me-postgres-password
# Database created on first start; also used to build DB_URL inside compose.
POSTGRES_DB=payments

# RabbitMQ user (non-default: the built-in "guest" user is not used). Also used to build RABBIT_URL inside compose.
RABBITMQ_DEFAULT_USER=payments
# RabbitMQ password. Change it.
RABBITMQ_DEFAULT_PASS=change-me-rabbitmq-password

# Optional host-side port mappings (all bound to 127.0.0.1 except where noted). Uncomment to avoid port clashes.
# POSTGRES_HOST_PORT=5432
# RABBITMQ_AMQP_HOST_PORT=5672
# RABBITMQ_UI_HOST_PORT=15672
# API_HOST_PORT=8000
# WEBHOOK_SINK_HOST_PORT=9000
# Interface the API port is published on; use 0.0.0.0 only if the API must be reachable from other machines.
# API_BIND_ADDRESS=127.0.0.1

# -----------------------------------------------------------------------------
# Connection URLs
# docker-compose.yml builds DB_URL and RABBIT_URL itself (hosts "postgres" / "rabbitmq" on the compose network).
# Uncomment and adjust ONLY to run a process directly on the host, e.g.:
#   uv run alembic upgrade head
#   uv run uvicorn payment_service.api.app:create_app --factory
#   uv run python -m payment_service.entrypoints.relay
# -----------------------------------------------------------------------------

# SQLAlchemy URL, must use the asyncpg driver (required).
# DB_URL=postgresql+asyncpg://payments:change-me-postgres-password@localhost:5432/payments
# AMQP URL (required).
# RABBIT_URL=amqp://payments:change-me-rabbitmq-password@localhost:5672/

# -----------------------------------------------------------------------------
# Application secrets (required, min. 16 characters each)
# -----------------------------------------------------------------------------

# Static key expected in the X-API-Key header of every /api/v1/* request.
API_KEY=change-me-api-key-0123456789
# HMAC-SHA256 key used to sign outgoing webhooks (X-Signature header).
WEBHOOK_SIGNING_SECRET=change-me-webhook-secret-0123456789

# -----------------------------------------------------------------------------
# API
# -----------------------------------------------------------------------------

# Expose Swagger UI / ReDoc / openapi.json. Set to false in production.
API_DOCS_ENABLED=true

# -----------------------------------------------------------------------------
# Webhooks
# -----------------------------------------------------------------------------

# SSRF guard: false = webhook_url must resolve to public addresses only. Keep false everywhere except demos.
# NOTE: docker-compose.yml overrides this to true for `api` and `consumer` so that the demo webhook-sink
# (a private address on the docker network) is reachable; this value applies to processes run on the host.
WEBHOOK_ALLOW_PRIVATE_NETWORKS=false
# Timeout of one webhook delivery attempt, seconds.
WEBHOOK_TIMEOUT_SECONDS=5.0
# User-Agent header of outgoing webhook requests.
WEBHOOK_USER_AGENT=payment-service-webhook/1.0

# -----------------------------------------------------------------------------
# Retry policy of the consumer (wait-queues with TTL, then DLQ)
# -----------------------------------------------------------------------------

# Total processing attempts (first try included) before a message goes to the DLQ.
RETRY_MAX_ATTEMPTS=3
# Delay before the 2nd attempt, seconds.
RETRY_BASE_DELAY_SECONDS=5.0
# Each following delay is multiplied by this factor (5s, 10s, ...).
RETRY_BACKOFF_FACTOR=2.0

# -----------------------------------------------------------------------------
# Transactional outbox relay
# -----------------------------------------------------------------------------

# Max outbox rows published per polling iteration.
OUTBOX_BATCH_SIZE=100
# Pause between polling iterations when the outbox is empty, seconds.
OUTBOX_POLL_INTERVAL_SECONDS=0.5
# Pause after a failed iteration (broker or database down), seconds.
OUTBOX_ERROR_BACKOFF_SECONDS=5.0
# Published outbox rows older than this are purged, hours.
OUTBOX_RETENTION_HOURS=72
# How often the purge runs, seconds.
OUTBOX_PURGE_INTERVAL_SECONDS=3600

# -----------------------------------------------------------------------------
# Payment gateway emulation
# -----------------------------------------------------------------------------

# Processing time is random between min and max, seconds.
GATEWAY_MIN_DELAY_SECONDS=2.0
GATEWAY_MAX_DELAY_SECONDS=5.0
# Probability (0..1) that the emulated gateway approves a payment.
GATEWAY_SUCCESS_RATE=0.9

# -----------------------------------------------------------------------------
# RabbitMQ consumption
# -----------------------------------------------------------------------------

# Max unacknowledged messages per consumer process = its concurrency limit.
RABBIT_PREFETCH_COUNT=10
# Queue type for declared queues: quorum (replicated, recommended) or classic.
RABBIT_QUEUE_TYPE=quorum

# -----------------------------------------------------------------------------
# Database pool
# -----------------------------------------------------------------------------

# Connections kept open per process.
DB_POOL_SIZE=10
# Extra connections allowed beyond the pool size under load.
DB_MAX_OVERFLOW=10
# Seconds to wait for a free connection before failing.
DB_POOL_TIMEOUT_SECONDS=30.0
# Log every SQL statement (debugging only).
DB_ECHO=false

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------

# DEBUG, INFO, WARNING, ERROR or CRITICAL.
LOG_LEVEL=INFO
# true = one JSON object per line (machine friendly); false = human readable lines.
LOG_JSON_FORMAT=true
